#
# Rendered by service.sh (CAMLAB_USER / CAMLAB_REPO_DIR substituted).
# camlab GUI fullscreen under Cage kiosk on tty1.

[Unit]
Description=camlab camera bench tool (Kurokesu)
After=systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=CAMLAB_USER
PAMName=camlab
WorkingDirectory=CAMLAB_REPO_DIR

# Persistent state (mode/fps selection). Read-only root keeps this on data partition.
StateDirectory=camlab
StateDirectoryMode=0750

TTYPath=/dev/tty1
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camlab

# Do not raise LIBCAMERA_LOG_LEVELS: ERROR lines are integrity signal.
Environment=PYTHONUNBUFFERED=1
# Blank cursor theme for Cage, so no pointer shows on boot screen. app.py
# drops it before Qt starts.
Environment=XCURSOR_PATH=/usr/local/lib/camlab/cursors

ExecStart=/usr/bin/cage -- /usr/bin/python3 -m camlab

Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
