#
# Paint boot logo onto DRM fbdevs as they appear. Name match skips the
# firmware simplefb, which kernel fullscreen logo already covers.
SUBSYSTEM=="graphics", KERNEL=="fb[0-9]*", ACTION=="add", ATTR{name}=="*drm*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="camlab-splash@%k.service"
