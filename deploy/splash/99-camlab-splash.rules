#
# Paint boot logo on DRM fbdevs as they appear. Skip simplefb (kernel logo covers it).
SUBSYSTEM=="graphics", KERNEL=="fb[0-9]*", ACTION=="add", ATTR{name}=="*drm*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="camlab-splash@%k.service"
