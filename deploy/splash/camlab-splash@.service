# Started by 99-camlab-splash.rules on DRM fbdev add. Device-activated only.

[Unit]
Description=Boot splash on %I
DefaultDependencies=no
ConditionPathExists=/lib/firmware/logo.tga

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/camlab/fbsplash.py /dev/%I
