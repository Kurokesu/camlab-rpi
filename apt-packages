#
# camlab apt package dependencies and supported OS. Sourced by install.sh and
# scripts/setup/deps.sh, rendered into deb Depends by debian/rules

# Supported Raspberry Pi OS release. Gates install.sh and reaches the deb
# preinst through debian/rules
OS_CODENAME="trixie"

# Floor pins for libcamera and rpicam-apps Kurokesu forks
# Stable names only, each pulls its own soname-named library and IPA
LIBCAMERA_PACKAGES="python3-libcamera"
LIBCAMERA_VERSION="1:0.7.2+rpt20260817+krks6"

RPICAM_APPS_PACKAGES="rpicam-apps-core"
RPICAM_APPS_VERSION="1:1.13.0+krks1"

# Floor pin, Raspberry Pi archive serves one version at a time
PICAMERA2_PACKAGES="python3-picamera2"
PICAMERA2_VERSION="0.3.38"

# Floor pin, dmabuf feedback for direct scanout landed in 0.3.1
CAGE_PACKAGES="cage"
CAGE_VERSION="0.3.1"

APP_PACKAGES="
awb-nn
python3-opengl
python3-pil
python3-pyqt6
python3-yaml
qt6-wayland
wlr-randr
wlrctl
"
