#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# Runtime relations for control, rendered from the source tree's apt-packages.
# Camera stack forks carry a floor and a ceiling, rest carry bare names.
# PICAMERA2_VERSION is recorded for drift checks, not rendered.
# ':?' stops the build on a missing key, rather than dropping dependencies.
# Unquoted expansion splits names, test_stack_pin.py on main asserts glob-free
ifeq ($(wildcard apt-packages),)
$(error apt-packages missing from source tree)
endif
DEPENDS := $(shell . ./apt-packages && set -o pipefail && { \
	pin() { for p in $$2; do echo "$$p (>= $$1)"; echo "$$p (<< $$1.)"; done; }; \
	pin "$${LIBCAMERA_VERSION:?}" "$${LIBCAMERA_PACKAGES:?}"; \
	pin "$${RPICAM_APPS_VERSION:?}" "$${RPICAM_APPS_PACKAGES:?}"; \
	printf '%s\n' $${APP_PACKAGES:?} $${PICAMERA2_PACKAGES:?}; \
	} | awk '{ printf "%s%s", sep, $$0; sep = ", " }')
ifneq ($(.SHELLSTATUS),0)
$(error apt-packages did not render Depends)
endif

OS_CODENAME := $(shell . ./apt-packages && printf '%s' "$${OS_CODENAME:?}")
ifneq ($(.SHELLSTATUS),0)
$(error apt-packages did not render OS_CODENAME)
endif

%:
	dh $@

override_dh_gencontrol:
	dh_gencontrol -- -V'camlab:Depends=$(DEPENDS)'

# Undefined token is left verbatim, shipping a gate that refuses every system.
# Negated grep passes on a missing file, so test the file exists first
override_dh_installdeb:
	dh_installdeb -DOS_CODENAME=$(OS_CODENAME)
	@test -f debian/camlab-rpi/DEBIAN/preinst \
		|| { echo "ERROR: preinst missing after dh_installdeb." >&2; exit 1; }
	@! grep -q '#OS_CODENAME#' debian/camlab-rpi/DEBIAN/preinst \
		|| { echo "ERROR: #OS_CODENAME# survived dh_installdeb." >&2; exit 1; }

# Interpreted Python tree, nothing to compile at packaging time.
# Bytecode is generated on target by postinst.
override_dh_auto_build:

# Payload is the whole source tree, mirroring what install.sh copies
# to /opt/camlab (export-ignore already trimmed the orig tarball).
# Copying everything keeps deb and install.sh trees identical by
# construction, no file list to drift.
#
# Source __version__ and changelog upstream version must agree in
# Debian form ('-' pre-release separator becomes '~'). '-dev' trees
# are exempt so branch CI can build the recipe against moving main.
override_dh_auto_install:
	@v="$$(sed -n 's/^__version__ = "\(.*\)"$$/\1/p' camlab/__init__.py)"; \
	case "$$v" in \
	*-dev) \
		echo "Version guard skipped: dev source tree ($$v)" ;; \
	*) \
		test "$$(printf '%s' "$$v" | sed 's/-/~/g')" = "$(DEB_VERSION_UPSTREAM)" || { \
			echo "ERROR: source __version__ ($$v) does not map to changelog upstream ($(DEB_VERSION_UPSTREAM))." >&2; \
			echo "Build against the paired v tag or fix debian/changelog." >&2; \
			exit 1; \
		} ;; \
	esac
	mkdir -p debian/camlab-rpi/opt/camlab
	tar -cf - --exclude=./debian --exclude=./.pc . \
		| tar -xf - -C debian/camlab-rpi/opt/camlab
