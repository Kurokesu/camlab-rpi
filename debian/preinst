#!/bin/sh
set -e

# OS gate for a bare dpkg -i, codename substituted by dh_installdeb
case "$1" in
    install|upgrade)
        # shellcheck source=/dev/null
        . /etc/os-release
        if [ "${VERSION_CODENAME:-}" != "#OS_CODENAME#" ]; then
            echo "camlab-rpi: unsupported OS: ${PRETTY_NAME:-unknown}," \
                 "need Raspberry Pi OS Lite (#OS_CODENAME# 64-bit)" >&2
            exit 1
        fi
        ;;
esac

#DEBHELPER#

exit 0
